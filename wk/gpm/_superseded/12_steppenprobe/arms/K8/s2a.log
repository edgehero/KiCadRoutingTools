CMD: Python -X utf8 py_router/route_diff.py wk/gpm/12_steppenprobe/arms/K8/s1.kicad_pcb wk/gpm/12_steppenprobe/arms/K8/s2a.kicad_pcb --nets "/USB_D*" --track-width 0.15 --diff-pair-gap 0.15 --clearance-ceiling 0.15 --escalation board --same-net-pad-clearance 0.1 --no-fix-drc-settings --layer-costs 1.0 2.0 --grid-step 0.05 --neckdown-taper-length 0
ENV KNOBS: KICAD_ROUTE_TRACE=1

  NOTE: '--neckdown-taper-length' begins with '-', so argparse read it as a flag rather than a value.
        A net (or layer) whose NAME starts with '-' must be attached with '=':
            --nets=--neckdown-taper-length          not   --nets --neckdown-taper-length
        Every name-taking list flag here has this shape (--nets, --power-nets,
        --rip-existing-nets, --plane-layers, ...).

